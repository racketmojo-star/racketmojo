---
import '@/styles/global.css';
export interface Props { lang: string; title: string; description: string; image?: string; }
const { lang, title, description, image } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — RacketMojo</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="RacketMojo" />
  {image && <meta property="og:image" content={image} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <header class="site-header">
    <div class="container nav-inner">
      <a href={`/${lang}/`} class="logo">
        <span class="logo-icon">◆</span> RacketMojo
      </a>
      <nav class="nav-links">
        <a href={`/${lang}/blog/`}>Blog</a>
        <a href="https://app.racketmojo.com" class="nav-cta">Try the App ↗</a>
        <div class="lang-switcher">
          {['en','ar','es'].map(l => (
            <a href={l===lang?'#':`/${l}/`} class={l===lang?'active':''}>{l.toUpperCase()}</a>
          ))}
        </div>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer>
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} RacketMojo</span>
      <div class="footer-links">
        <a href="https://instagram.com/racketmojo">Instagram</a>
        <a href="https://app.racketmojo.com">Try the App</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border-light);
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 0.75rem; padding-bottom: 0.75rem;
  }
  .logo {
    display: flex; align-items: center; gap: 0.4rem;
    font-weight: 800; font-size: 1.1rem; color: var(--color-text);
  }
  .logo-icon { color: var(--color-orange); font-size: 1.2rem; }
  .logo:hover { opacity: 0.8; }

  .nav-links { display: flex; gap: 0.75rem; align-items: center; }
  .nav-links a { font-size: 0.85rem; color: var(--color-text-muted); }
  .nav-links a:hover { color: var(--color-orange); }
  .nav-cta {
    background: var(--color-orange) !important;
    color: #fff !important;
    padding: 0.35rem 0.75rem; border-radius: 6px;
    font-weight: 600 !important; font-size: 0.8rem !important;
    white-space: nowrap;
  }
  .nav-cta:hover { background: var(--color-orange-dark) !important; }

  .lang-switcher { display: flex; gap: 0.25rem; }
  .lang-switcher a {
    font-size: 0.7rem; padding: 0.2rem 0.4rem; border-radius: 4px;
    color: var(--color-text-muted); font-weight: 600;
  }
  .lang-switcher a.active {
    background: var(--color-orange); color: #fff;
  }

  footer {
    border-top: 1px solid var(--color-border-light);
    margin-top: 3rem; padding: 1.5rem 0;
    font-size: 0.8rem; color: var(--color-text-dim);
  }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  .footer-links { display: flex; gap: 1rem; }
  .footer-links a { color: var(--color-text-dim); }
  .footer-links a:hover { color: var(--color-orange); }

  @media(max-width:480px) {
    .nav-links { gap: 0.5rem; }
    .nav-links a { font-size: 0.75rem; }
    .nav-cta { padding: 0.3rem 0.6rem; font-size: 0.7rem !important; }
  }
</style>
