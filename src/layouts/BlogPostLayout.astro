---
// BlogPostLayout.astro — Refined blog post layout
import BaseLayout from './BaseLayout.astro';
import AppCtaCard from '../components/AppCtaCard.astro';
import Schema from '../components/SEO/Schema.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
  lang: string;
  relatedPosts?: CollectionEntry<'posts'>[];
}

const { post, lang, relatedPosts = [] } = Astro.props;
const { title, description, heroImage, pubDate, tags } = post.data;

const wordCount = post.body?.split(/\s+/).length || 800;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

const relatedLabels: Record<string, string> = {
  en: 'You might also like',
  ar: 'قد يعجبك أيضاً',
  es: 'También te puede gustar',
};
const relatedLabel = relatedLabels[lang] || relatedLabels.en;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishDate={pubDate}
>
  <Schema
    slot="head"
    type="article"
    title={title}
    description={description}
    image={heroImage}
    publishDate={pubDate}
    tags={tags}
  />
  <article class="container article">
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="tags-row">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <h1 class="article-title">{title}</h1>

    <div class="meta-row">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'long',day:'numeric'})}
      </time>
      <span class="meta-sep">·</span>
      <span>{readTime} min read</span>
    </div>

    {heroImage && (
      <div class="hero-wrap">
        <img src={heroImage} alt={title} class="hero-img" />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <AppCtaCard />

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <h2 class="related-heading">{relatedLabel}</h2>
        <div class="related-grid">
          {relatedPosts.map(rp => {
            const rpSlug = rp.id.replace(new RegExp(`-${lang}\\.mdx?$`), '');
            const rpWords = rp.body?.split(/\s+/).length || 800;
            const rpReadTime = Math.max(1, Math.ceil(rpWords / 200));
            return (
              <a href={`/${lang}/blog/${rpSlug}/`} class="related-card">
                {rp.data.heroImage && (
                  <div class="related-card-img">
                    <img src={rp.data.heroImage} alt={rp.data.title} loading="lazy" />
                  </div>
                )}
                <div class="related-card-body">
                  <div class="related-card-tags">
                    {rp.data.tags.slice(0, 2).map(tag => (
                      <span class="related-tag">{tag}</span>
                    ))}
                  </div>
                  <h3 class="related-card-title">{rp.data.title}</h3>
                  <div class="related-card-meta">
                    <time datetime={rp.data.pubDate.toISOString()}>
                      {rp.data.pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'short',day:'numeric'})}
                    </time>
                    <span class="related-dot">·</span>
                    <span>{rpReadTime} min</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <nav class="back-nav">
      <a href={`/${lang}/blog/`}>← Back to Blog</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .tags-row {
    display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem;
  }
  .tag {
    background: rgba(246,180,24,0.1); color: var(--color-orange-dark);
    padding: 0.22rem 0.65rem; border-radius: 100px;
    font-size: 0.68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.5px;
  }

  .article-title {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.02em;
    line-height: 1.2; margin-bottom: 0.5rem;
  }

  .meta-row {
    display: flex; gap: 0.5rem; align-items: center;
    color: var(--color-text-dim); font-size: 0.85rem; margin-bottom: 2rem;
  }
  .meta-sep { color: var(--color-border); }

  .hero-wrap {
    margin-bottom: 2.5rem; border-radius: 16px; overflow: hidden;
    box-shadow: 0 4px 30px rgba(0,0,0,0.07);
  }
  .hero-img { width: 100%; display: block; }

  /* ─── Related Posts ─── */
  .related-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-light);
  }
  .related-heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 500px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 768px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .related-card {
    background: #fff;
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    overflow: hidden;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .related-card:hover {
    border-color: var(--color-orange);
    box-shadow: 0 4px 16px rgba(0,0,0,0.05);
  }
  .related-card-img {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #f5f5f5;
  }
  .related-card-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.3s;
  }
  .related-card:hover .related-card-img img {
    transform: scale(1.04);
  }
  .related-card-body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .related-card-tags {
    display: flex; gap: 0.3rem; flex-wrap: wrap; margin-bottom: 0.4rem;
  }
  .related-tag {
    background: rgba(246,180,24,0.1); color: var(--color-orange-dark);
    padding: 0.13rem 0.4rem; border-radius: 100px;
    font-size: 0.58rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.4px;
  }
  .related-card-title {
    font-size: 0.88rem; font-weight: 700; line-height: 1.3;
    margin-bottom: 0.5rem;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-meta {
    font-size: 0.7rem; color: var(--color-text-dim);
    display: flex; gap: 0.3rem; align-items: center;
  }
  .related-dot { color: var(--color-border); }

  /* Back nav */
  .back-nav {
    margin-top: 2.5rem; padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-light);
  }
  .back-nav a {
    color: var(--color-orange); font-weight: 600; font-size: 0.9rem;
  }
  .back-nav a:hover { color: var(--color-orange-dark); }

  @media (max-width: 480px) {
    .article { padding-top: 1.5rem; }
    .hero-wrap { margin-bottom: 1.5rem; border-radius: 12px; }
    .related-section { margin-top: 2rem; padding-top: 1.5rem; }
  }
</style>
