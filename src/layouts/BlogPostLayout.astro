---
// BlogPostLayout.astro — Professional blog post with styled content
import BaseLayout from './BaseLayout.astro';
import AppCtaCard from '../components/AppCtaCard.astro';
import type { CollectionEntry } from 'astro:content';
export interface Props { post: CollectionEntry<'posts'>; lang: string; }
const { post, lang } = Astro.props;
const { title, description, heroImage, pubDate, tags, author } = post.data;

// Reading time estimate (~200 words/min, markdown words)
const wordCount = post.body?.split(/\s+/).length || 800;
const readTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout lang={lang} title={title} description={description} image={heroImage}>
  <article class="container article">
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="tags-row">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <h1 class="article-title">{title}</h1>

    <!-- Meta row -->
    <div class="meta-row">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'long',day:'numeric'})}
      </time>
      <span class="meta-sep">·</span>
      <span>{readTime} min read</span>
    </div>

    <!-- Hero image -->
    {heroImage && (
      <div class="hero-wrap">
        <img src={heroImage} alt={title} class="hero-img" />
      </div>
    )}

    <!-- Content -->
    <div class="prose">
      <slot />
    </div>

    <!-- App CTA -->
    <AppCtaCard />

    <!-- Back -->
    <nav class="back-nav">
      <a href={`/${lang}/blog/`}>← Back to Blog</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .article { padding-top: 2rem; padding-bottom: 3rem; }

  /* Tags */
  .tags-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .tag {
    background: rgba(246,180,24,0.1); color: var(--color-orange-dark);
    padding: 0.2rem 0.6rem; border-radius: 4px;
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
  }

  /* Title */
  .article-title { font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.25; margin-bottom: 0.5rem; }

  /* Meta */
  .meta-row { display: flex; gap: 0.5rem; align-items: center; color: var(--color-text-dim); font-size: 0.82rem; margin-bottom: 1.75rem; }
  .meta-sep { color: var(--color-border); }

  /* Hero */
  .hero-wrap { margin-bottom: 2.5rem; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
  .hero-img { width: 100%; display: block; }

  /* ─── PROSE ─── */
  .prose { max-width: var(--max-width); font-size: 1.05rem; line-height: 1.75; }
  .prose h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.4rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-border-light); }
  .prose h3 { margin-top: 2rem; margin-bottom: 0.6rem; font-size: 1.15rem; color: var(--color-text); }
  .prose p { margin-bottom: 1.25rem; }
  .prose ul, .prose ol { margin: 0.75rem 0 1.5rem 1.5rem; }
  .prose li { margin-bottom: 0.5rem; padding-left: 0.25rem; }
  .prose li::marker { color: var(--color-orange); }
  .prose strong { color: var(--color-orange-dark); font-weight: 700; }
  .prose a { color: var(--color-orange-dark); text-decoration: underline; text-underline-offset: 2px; }
  .prose a:hover { color: var(--color-orange); }
  .prose blockquote {
    margin: 2rem 0; padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, rgba(246,180,24,0.04), rgba(246,180,24,0.01));
    border-left: 3px solid var(--color-orange);
    border-radius: 0 10px 10px 0;
    font-style: normal; color: var(--color-text);
  }
  .prose blockquote strong { color: var(--color-orange-dark); }
  .prose hr { border: none; border-top: 1px solid var(--color-border-light); margin: 2.5rem 0; }

  /* ─── TABLES (gorgeous) ─── */
  .prose table {
    width: 100%; margin: 2rem 0; border-collapse: separate; border-spacing: 0;
    border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04); font-size: 0.9rem;
  }
  .prose thead { background: linear-gradient(135deg, var(--color-orange), var(--color-orange-dark)); }
  .prose th {
    text-align: left; padding: 0.75rem 1rem; font-weight: 700; color: #fff;
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.6px; border: none;
  }
  .prose th:first-child { border-radius: 0; }
  .prose td {
    text-align: left; padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border-light);
    background: #fff; transition: background 0.15s;
  }
  .prose tr:last-child td { border-bottom: none; }
  .prose tr:nth-child(even) td { background: #FAFBFC; }
  .prose tr:hover td { background: rgba(246,180,24,0.04); }
  .prose td:first-child { font-weight: 600; color: var(--color-text); }
  [dir=rtl] .prose th, [dir=rtl] .prose td { text-align: right; }

  /* ─── STAR RATINGS (inline) ─── */
  .prose td:has(★), .prose td:has(☆) { letter-spacing: 2px; }
  .prose ★ { color: var(--color-orange); }
  .prose ☆ { color: var(--color-border); }

  /* ─── MOBILE TABLE (horizontal scroll) ─── */
  @media(max-width:600px) {
    .prose { font-size: 1rem; }
    .prose table { font-size: 0.8rem; display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .prose th, .prose td { padding: 0.55rem 0.7rem; white-space: nowrap; }
    .prose th { font-size: 0.7rem; }
  }

  /* Back nav */
  .back-nav { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border-light); }
  .back-nav a { color: var(--color-orange); font-weight: 600; font-size: 0.9rem; }

  @media(max-width:480px) {
    .article { padding-top: 1.25rem; }
    .hero-wrap { margin-bottom: 1.5rem; border-radius: 10px; }
    .prose h2 { font-size: 1.2rem; }
  }
</style>
