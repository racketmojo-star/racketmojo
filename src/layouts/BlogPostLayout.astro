---
// BlogPostLayout.astro — Refined blog post layout with TOC, share, author, FAQ
import BaseLayout from './BaseLayout.astro';
import AppCtaCard from '../components/AppCtaCard.astro';
import Schema from '../components/SEO/Schema.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
  lang: string;
  relatedPosts?: CollectionEntry<'posts'>[];
}

const { post, lang, relatedPosts = [] } = Astro.props;
const { title, description, heroImage, pubDate, tags, faq = [], author = 'RacketMojo' } = post.data;

const wordCount = post.body?.split(/\s+/).length || 800;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

const relatedLabels: Record<string, string> = {
  en: 'You might also like',
  ar: 'قد يعجبك أيضاً',
  es: 'También te puede gustar',
};
const relatedLabel = relatedLabels[lang] || relatedLabels.en;

const tocLabels: Record<string, string> = {
  en: 'In this article',
  ar: 'في هذا المقال',
  es: 'En este artículo',
};
const tocLabel = tocLabels[lang] || tocLabels.en;

const shareLabels: Record<string, string> = {
  en: 'Share',
  ar: 'شارك',
  es: 'Compartir',
};
const shareLabel = shareLabels[lang] || shareLabels.en;

const authorLabels: Record<string, string> = {
  en: 'Written by',
  ar: 'كتب بواسطة',
  es: 'Escrito por',
};
const authorLabel = authorLabels[lang] || authorLabels.en;

const faqLabels: Record<string, string> = {
  en: 'Frequently Asked Questions',
  ar: 'الأسئلة الشائعة',
  es: 'Preguntas Frecuentes',
};
const faqLabel = faqLabels[lang] || faqLabels.en;

const canonicalUrl = `https://racketmojo.com/${lang}/blog/${post.id.replace(new RegExp(`-${lang}\\.mdx?$`), '')}/`;
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(canonicalUrl);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishDate={pubDate}
>
  <Schema
    slot="head"
    type="article"
    title={title}
    description={description}
    image={heroImage}
    publishDate={pubDate}
    tags={tags}
    faq={faq}
  />
  <article class="container article">
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="tags-row">
        {tags.map(tag => <a class="tag" href={`/${lang}/blog/tag/${encodeURIComponent(tag)}/`}>{tag}</a>)}
      </div>
    )}

    <h1 class="article-title">{title}</h1>

    <div class="meta-row">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'long',day:'numeric'})}
      </time>
      <span class="meta-sep">·</span>
      <span>{readTime} min read</span>
      <span class="meta-sep">·</span>
      <span class="author-meta">{authorLabel}: {author}</span>
    </div>

    {heroImage && (
      <div class="hero-wrap">
        <img src={heroImage} alt={title} class="hero-img" loading="eager" fetchpriority="high" width="1200" height="675" />
      </div>
    )}

    <div class="article-layout">
      <!-- TOC -->
      <nav class="toc" aria-label={tocLabel}>
        <div class="toc-title">{tocLabel}</div>
        <ul class="toc-list" id="toc-list"></ul>
      </nav>

      <div class="article-main">
        <div class="prose" id="article-prose">
          <slot />
        </div>

        <!-- FAQ Section -->
        {faq.length > 0 && (
          <section class="faq-section" id="faq">
            <h2 class="faq-heading">{faqLabel}</h2>
            <div class="faq-list">
              {faq.map(item => (
                <details class="faq-item">
                  <summary class="faq-q">{item.q}</summary>
                  <p class="faq-a">{item.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Share buttons -->
        <div class="share-row">
          <span class="share-label">{shareLabel}:</span>
          <a class="share-btn share-wa" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a class="share-btn share-tg" href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener" aria-label="Share on Telegram">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            Telegram
          </a>
          <a class="share-btn share-x" href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on X">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
        </div>

        <AppCtaCard />

        <!-- Author bio -->
        <div class="author-box">
          <div class="author-avatar" aria-hidden="true">{author.charAt(0).toUpperCase()}</div>
          <div class="author-info">
            <div class="author-name">{authorLabel}: <strong>{author}</strong></div>
            <p class="author-bio">
              {lang === 'ar'
                ? 'نصائح وخبرات عملية في البادل لمساعدتك على اختيار المعدات المناسبة وتحسين مستواك.'
                : lang === 'es'
                  ? 'Consejos prácticos de pádel para ayudarte a elegir el equipamiento adecuado y mejorar tu juego.'
                  : 'Practical padel insights to help you choose the right gear and improve your game.'}
            </p>
          </div>
        </div>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <section class="related-section">
            <h2 class="related-heading">{relatedLabel}</h2>
            <div class="related-grid">
              {relatedPosts.map(rp => {
                const rpSlug = rp.id.replace(new RegExp(`-${lang}\\.mdx?$`), '');
                const rpWords = rp.body?.split(/\s+/).length || 800;
                const rpReadTime = Math.max(1, Math.ceil(rpWords / 200));
                return (
                  <a href={`/${lang}/blog/${rpSlug}/`} class="related-card">
                    {rp.data.heroImage && (
                      <div class="related-card-img">
                        <img src={rp.data.heroImage} alt={rp.data.title} loading="lazy" width="1200" height="675" />
                      </div>
                    )}
                    <div class="related-card-body">
                      <div class="related-card-tags">
                        {rp.data.tags.slice(0, 2).map(tag => (
                          <span class="related-tag">{tag}</span>
                        ))}
                      </div>
                      <h3 class="related-card-title">{rp.data.title}</h3>
                      <div class="related-card-meta">
                        <time datetime={rp.data.pubDate.toISOString()}>
                          {rp.data.pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'short',day:'numeric'})}
                        </time>
                        <span class="related-dot">·</span>
                        <span>{rpReadTime} min</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <nav class="back-nav">
          <a href={`/${lang}/blog/`}>← Back to Blog</a>
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // TOC builder + scrollspy — runs client-side, zero build risk
  function buildToc() {
    const prose = document.getElementById('article-prose');
    const tocList = document.getElementById('toc-list');
    if (!prose || !tocList) return;

    const headings = prose.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      const toc = document.querySelector('.toc');
      if (toc) toc.style.display = 'none';
      return;
    }

    const items: { id: string; text: string; level: number }[] = [];
    headings.forEach((h, i) => {
      if (!h.id) {
        const base = (h.textContent || 'heading').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        h.id = `${base}-${i}`;
      }
      items.push({ id: h.id, text: h.textContent || '', level: h.tagName === 'H3' ? 3 : 2 });
    });

    items.forEach(item => {
      const li = document.createElement('li');
      li.className = item.level === 3 ? 'toc-item toc-sub' : 'toc-item';
      const a = document.createElement('a');
      a.href = `#${item.id}`;
      a.textContent = item.text;
      a.dataset.target = item.id;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Scrollspy
    const links = tocList.querySelectorAll('a');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          links.forEach(l => l.classList.toggle('active', l.dataset.target === entry.target.id));
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    headings.forEach(h => observer.observe(h));

    // Smooth scroll
    links.forEach(a => {
      a.addEventListener('click', e => {
        const target = document.getElementById(a.dataset.target || '');
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${a.dataset.target}`);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', buildToc);
  } else {
    buildToc();
  }
</script>

<style>
  .article {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .tags-row {
    display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem;
  }
  .tag {
    background: rgba(246,180,24,0.1); color: var(--color-orange-dark);
    padding: 0.22rem 0.65rem; border-radius: 100px;
    font-size: 0.68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.5px;
    text-decoration: none;
  }
  .tag:hover { background: rgba(246,180,24,0.2); }

  .article-title {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.02em;
    line-height: 1.2; margin-bottom: 0.5rem;
  }

  .meta-row {
    display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
    color: var(--color-text-dim); font-size: 0.85rem; margin-bottom: 2rem;
  }
  .meta-sep { color: var(--color-border); }
  .author-meta { color: var(--color-orange-dark); font-weight: 600; }

  .hero-wrap {
    margin-bottom: 2.5rem; border-radius: 16px; overflow: hidden;
    box-shadow: 0 4px 30px rgba(0,0,0,0.07);
  }
  .hero-img { width: 100%; display: block; }

  /* ─── Two-column article layout ─── */
  .article-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .toc {
    position: sticky; top: 5rem;
    font-size: 0.78rem;
    border-left: 2px solid var(--color-border-light);
    padding-left: 1rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
  }
  .toc-title {
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
    font-size: 0.65rem; color: var(--color-text-muted); margin-bottom: 0.6rem;
  }
  .toc-list { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
  .toc-item a {
    color: var(--color-text-muted); text-decoration: none; display: block;
    padding: 0.2rem 0; line-height: 1.35;
  }
  .toc-item a:hover { color: var(--color-orange); }
  .toc-item a.active { color: var(--color-orange); font-weight: 700; }
  .toc-sub { padding-left: 0.8rem; }
  .toc-sub a { font-size: 0.72rem; }

  .article-main { min-width: 0; }

  /* ─── FAQ ─── */
  .faq-section {
    margin-top: 2.5rem; padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }
  .faq-heading { font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .faq-item {
    background: var(--color-surface); border-radius: 10px; padding: 0.9rem 1.1rem;
  }
  .faq-q { font-weight: 700; font-size: 0.92rem; cursor: pointer; color: var(--color-text); }
  .faq-a { margin-top: 0.5rem; font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.55; }

  /* ─── Share ─── */
  .share-row {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    margin: 2rem 0 0.5rem; padding: 1rem 0;
    border-top: 1px solid var(--color-border-light);
  }
  .share-label { font-size: 0.82rem; color: var(--color-text-muted); font-weight: 600; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.45rem 0.85rem; border-radius: 100px;
    font-size: 0.75rem; font-weight: 700; text-decoration: none;
    color: #fff; transition: opacity 0.2s;
  }
  .share-btn:hover { opacity: 0.85; }
  .share-wa { background: #25D366; }
  .share-tg { background: #229ED9; }
  .share-x { background: #14171A; }

  /* ─── Author box ─── */
  .author-box {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--color-surface); border-radius: 14px;
    padding: 1.25rem 1.5rem; margin-top: 2rem;
  }
  .author-avatar {
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--color-orange); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; font-weight: 800; flex-shrink: 0;
  }
  .author-name { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.25rem; }
  .author-bio { font-size: 0.83rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }

  /* ─── Related Posts ─── */
  .related-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-light);
  }
  .related-heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 500px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 768px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .related-card {
    background: #fff;
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    overflow: hidden;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .related-card:hover {
    border-color: var(--color-orange);
    box-shadow: 0 4px 16px rgba(0,0,0,0.05);
  }
  .related-card-img {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #f5f5f5;
  }
  .related-card-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.3s;
  }
  .related-card:hover .related-card-img img {
    transform: scale(1.04);
  }
  .related-card-body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .related-card-tags {
    display: flex; gap: 0.3rem; flex-wrap: wrap; margin-bottom: 0.4rem;
  }
  .related-tag {
    background: rgba(246,180,24,0.1); color: var(--color-orange-dark);
    padding: 0.13rem 0.4rem; border-radius: 100px;
    font-size: 0.58rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.4px;
  }
  .related-card-title {
    font-size: 0.88rem; font-weight: 700; line-height: 1.3;
    margin-bottom: 0.5rem;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-meta {
    font-size: 0.7rem; color: var(--color-text-dim);
    display: flex; gap: 0.3rem; align-items: center;
  }
  .related-dot { color: var(--color-border); }

  /* Back nav */
  .back-nav {
    margin-top: 2.5rem; padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-light);
  }
  .back-nav a {
    color: var(--color-orange); font-weight: 600; font-size: 0.9rem;
  }
  .back-nav a:hover { color: var(--color-orange-dark); }

  @media (max-width: 768px) {
    .article-layout { grid-template-columns: 1fr; gap: 0; }
    .toc {
      position: static; max-height: none;
      border-left: none; padding-left: 0;
      border-bottom: 1px solid var(--color-border-light);
      padding-bottom: 1rem; margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .article { padding-top: 1.5rem; }
    .hero-wrap { margin-bottom: 1.5rem; border-radius: 12px; }
    .related-section { margin-top: 2rem; padding-top: 1.5rem; }
  }
</style>
