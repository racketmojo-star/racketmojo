---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params;
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(p => p.id.includes(`-${lang}.md`) && !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageTitles = { en: 'Blog', ar: 'المدونة', es: 'Blog' };
---

<BaseLayout lang={lang} title={pageTitles[lang]} description="Padel racket guides, comparisons, and tips.">
  <div class="container" style="padding-top:2rem;padding-bottom:3rem;">
    <h1 style="margin-bottom:1.5rem;">{pageTitles[lang]}</h1>
    <div class="blog-list">
      {posts.map(post => (
        <article class="bc">
          <a href={`/${lang}/blog/${post.id.replace(`-${lang}.md`, '')}/`}>
            <div class="bc-tags">
              {post.data.tags.slice(0, 3).map(tag => <span class="bt">{tag}</span>)}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'long',day:'numeric'})}
            </time>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .bc {
    background: var(--color-surface); border: 1px solid var(--color-border-light);
    border-radius: 10px; transition: border-color .15s;
  }
  .bc:hover { border-color: var(--color-orange); }
  .bc a { display: block; padding: 1.25rem; color: inherit; }
  .bt {
    display: inline-block;
    background: rgba(246,180,24,0.1); color: var(--color-orange-dark);
    padding: 0.15rem 0.5rem; border-radius: 4px;
    font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.3px; margin-right: 0.3rem; margin-bottom: 0.3rem;
  }
  .bc h2 { font-size: 1.1rem; margin-bottom: 0.3rem; line-height: 1.3; }
  .bc p { font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .bc time { font-size: 0.75rem; color: var(--color-text-dim); }

  @media(max-width:480px) {
    .bc a { padding: 0.9rem; }
    .bc h2 { font-size: 0.95rem; }
    .bc p { font-size: 0.8rem; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  }
</style>
