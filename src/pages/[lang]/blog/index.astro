---
// [lang]/blog/index.astro — Blog index per locale
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;

// Filter posts by language: post id = "first-racket-en.md"
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(p => p.id.includes(`-${lang}.md`))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageTitles = {
  en: 'Blog',
  ar: 'المدونة',
  es: 'Blog',
};
---

<BaseLayout lang={lang} title={pageTitles[lang] || 'Blog'} description="RacketMojo blog — padel racket guides, tips, and AI insights.">
  <div class="container" style="padding-top:3rem;padding-bottom:4rem;">
    <h1 style="margin-bottom:2.5rem;">{pageTitles[lang] || 'Blog'}</h1>

    {posts.length === 0 ? (
      <p style="color:var(--color-text-muted);">No posts yet. Check back soon.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:1.5rem;">
        {posts.map(post => (
          <article class="post-card">
            <div class="post-card-body">
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.5rem;">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2 style="font-size:1.3rem;margin-bottom:0.5rem;">
                <a href={`/${lang}/blog/${post.id.replace(`-${lang}.md`, '')}/`} style="color:#fff;text-decoration:none;">
                  {post.data.title}
                </a>
              </h2>
              <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:0.75rem;">
                {post.data.description}
              </p>
              <time datetime={post.data.pubDate.toISOString()} style="color:var(--color-text-dim);font-size:0.8rem;">
                {post.data.pubDate.toLocaleDateString(lang === 'ar' ? 'ar-SA' : lang === 'es' ? 'es-ES' : 'en-US', {
                  year: 'numeric', month: 'long', day: 'numeric',
                })}
              </time>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .post-card {
    background: var(--color-dark-card);
    border: 1px solid var(--color-dark-border);
    border-radius: 12px;
    transition: border-color 0.2s;
  }
  .post-card:hover {
    border-color: var(--color-gold);
  }
  .post-card-body {
    padding: 1.5rem;
  }
  .tag {
    background: rgba(246, 180, 24, 0.12);
    color: var(--color-gold);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .post-card h2 a:hover {
    color: var(--color-gold) !important;
  }
</style>
