---
// [lang]/blog/tag/[tag].astro — Tag hub page listing all posts with this tag
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const langs = ['en', 'ar', 'es'];
  const paths = [];

  for (const lang of langs) {
    const langPosts = posts.filter(p => p.id.includes(`-${lang}.md`) || p.id.includes(`-${lang}.mdx`));
    const tags = new Set<string>();
    langPosts.forEach(p => p.data.tags.forEach(t => tags.add(t)));
    for (const tag of tags) {
      paths.push({ params: { lang, tag } });
    }
  }
  return paths;
}

const { lang, tag } = Astro.params;
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(p => (p.id.includes(`-${lang}.md`) || p.id.includes(`-${lang}.mdx`))
    && !p.data.draft
    && p.data.tags.includes(tag!))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageTitles = { en: `Tag: ${tag}`, ar: `الوسم: ${tag}`, es: `Etiqueta: ${tag}` };
const pageDescs = {
  en: `All RacketMojo articles tagged "${tag}" — padel guides, gear reviews, and tips.`,
  ar: `جميع مقالات RacketMojo الموسومة "${tag}" — أدلة البادل، مراجعات المعدات، ونصائح.`,
  es: `Todos los artículos de RacketMojo etiquetados "${tag}" — guías de pádel, reseñas y consejos.`,
};
---

<BaseLayout lang={lang} title={pageTitles[lang]} description={pageDescs[lang]}>
  <div class="tag-page">
    <div class="container-wide">
      <h1 class="tag-heading">{pageTitles[lang]}</h1>
      <p class="tag-sub">{posts.length} {lang === 'ar' ? 'مقال' : lang === 'es' ? 'artículos' : 'articles'}</p>

      <div class="blog-list">
        {posts.map(post => {
          const slug = post.id.replace(new RegExp(`-${lang}\\.mdx?$`), '');
          const wordCount = post.body?.split(/\s+/).length || 800;
          const readTime = Math.max(1, Math.ceil(wordCount / 200));
          return (
            <a href={`/${lang}/blog/${slug}/`} class="bc">
              {post.data.heroImage && (
                <div class="bc-img">
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" width="1200" height="675" />
                </div>
              )}
              <div class="bc-body">
                <div class="bc-tags">
                  {post.data.tags.slice(0, 3).map(t => (
                    <span class="bc-tag">{t}</span>
                  ))}
                </div>
                <h2 class="bc-title">{post.data.title}</h2>
                <p class="bc-desc">{post.data.description}</p>
                <div class="bc-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString(lang==='ar'?'ar-SA':lang==='es'?'es-ES':'en-US',{year:'numeric',month:'long',day:'numeric'})}
                  </time>
                  <span class="bc-dot">·</span>
                  <span>{readTime} min read</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <nav class="back-nav">
        <a href={`/${lang}/blog/`}>← {lang === 'ar' ? 'العودة إلى المدونة' : lang === 'es' ? 'Volver al Blog' : 'Back to Blog'}</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .tag-page { padding: 3rem 0 4rem; }
  .container-wide { max-width: 900px; margin: 0 auto; padding: 0 1.5rem; }
  .tag-heading { font-size: clamp(1.6rem, 4.5vw, 2.2rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.3rem; }
  .tag-sub { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 2rem; }

  .blog-list { display: flex; flex-direction: column; gap: 1rem; }

  .bc {
    display: grid;
    grid-template-columns: 200px 1fr;
    background: #fff;
    border: 1px solid var(--color-border-light);
    border-radius: 14px;
    overflow: hidden;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .bc:hover { border-color: var(--color-orange); box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
  .bc-img { aspect-ratio: 16/10; overflow: hidden; background: #f5f5f5; }
  .bc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .bc:hover .bc-img img { transform: scale(1.04); }
  .bc-body { padding: 1.5rem 1.75rem; display: flex; flex-direction: column; justify-content: center; }
  .bc-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .bc-tag { background: rgba(246,180,24,0.1); color: var(--color-orange-dark); padding: 0.16rem 0.5rem; border-radius: 100px; font-size: 0.63rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
  .bc-title { font-size: 1.15rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.35rem; }
  .bc-desc { font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0.75rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .bc-meta { font-size: 0.78rem; color: var(--color-text-dim); display: flex; gap: 0.35rem; align-items: center; }
  .bc-dot { color: var(--color-border); }
  .back-nav { margin-top: 2rem; }
  .back-nav a { color: var(--color-orange); font-weight: 600; font-size: 0.9rem; }

  @media (max-width: 640px) {
    .tag-page { padding: 2rem 0 3rem; }
    .container-wide { padding: 0 1rem; }
    .bc { grid-template-columns: 1fr; }
    .bc-img { aspect-ratio: 2/1; }
    .bc-body { padding: 1.1rem 1.2rem; }
  }
</style>
