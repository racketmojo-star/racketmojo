---
// [lang]/blog/[slug].astro — Individual blog post page
import { getCollection } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  const paths = [];
  for (const post of posts) {
    // post.id = "first-racket-en.md" → slug="first-racket", lang="en"
    const match = post.id.match(/^(.+)-(\w{2})\.mdx?$/);
    if (match) {
      const [, slug, lang] = match;
      paths.push({ params: { lang, slug } });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params;

// Find the post matching this slug + locale
const postId = `${slug}-${lang}.md`;
const postIdMdx = `${slug}-${lang}.mdx`;
const post = (await getCollection('posts')).find(p => p.id === postId || p.id === postIdMdx);

if (!post) {
  return Astro.redirect(`/${lang}/blog/`);
}

const { Content } = await post.render();
---

<BlogPostLayout post={post} lang={lang}>
  <Content />
</BlogPostLayout>
