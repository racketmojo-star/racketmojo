---
// AppCtaCard.astro — Natural CTA in every blog post
---

<div class="cta-card">
  <div class="cta-inner">
    <span class="cta-icon">◆</span>
    <div class="cta-body">
      <h3>Not sure which racket is right for you?</h3>
      <p>Our AI analyzes your playing style and recommends the perfect racket — in under 2 minutes.</p>
      <a href="https://app.racketmojo.com" class="cta-btn">Try the Racket Finder →</a>
    </div>
  </div>
</div>

<style>
  .cta-card {
    margin: 2.5rem 0;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(246,180,24,0.06), rgba(246,180,24,0.02));
    border: 1px solid rgba(246,180,24,0.25);
  }
  .cta-inner {
    display: flex; align-items: center; gap: 1.25rem; padding: 1.5rem;
  }
  .cta-icon {
    font-size: 2.2rem; color: var(--color-orange); flex-shrink: 0;
  }
  .cta-body h3 { margin: 0 0 0.3rem; font-size: 1.05rem; }
  .cta-body p { margin: 0 0 0.75rem; color: var(--color-text-muted); font-size: 0.9rem; }
  .cta-btn {
    display: inline-block; background: var(--color-orange); color: #fff !important;
    padding: 0.5rem 1.25rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem;
    transition: background .15s;
  }
  .cta-btn:hover { background: var(--color-orange-dark); }

  @media(max-width:500px) {
    .cta-inner { flex-direction: column; text-align: center; padding: 1.25rem; }
    .cta-icon { font-size: 1.8rem; }
    .cta-btn { width: 100%; text-align: center; }
  }
</style>
