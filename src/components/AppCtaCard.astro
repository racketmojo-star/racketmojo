---
// AppCtaCard.astro — Natural CTA card inserted into every blog post
// Encourages readers to try the AI racket recommender at app.racketmojo.com
---

<div class="app-cta-card">
  <div class="app-cta-inner">
    <div class="app-cta-icon">◆</div>
    <div class="app-cta-content">
      <h3>Not sure which racket is right for you?</h3>
      <p>Our AI analyzes your playing style and recommends the perfect racket — in under 2 minutes.</p>
      <a href="https://app.racketmojo.com" class="app-cta-btn">
        Try the Racket Finder →
      </a>
    </div>
  </div>
</div>

<style>
  .app-cta-card {
    margin: 3rem 0;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(246, 180, 24, 0.08), rgba(246, 180, 24, 0.03));
    border: 1px solid rgba(246, 180, 24, 0.2);
    overflow: hidden;
  }
  .app-cta-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
  }
  .app-cta-icon {
    font-size: 2.5rem;
    color: var(--color-gold);
    flex-shrink: 0;
    opacity: 0.8;
  }
  .app-cta-content h3 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    color: #fff;
  }
  .app-cta-content p {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .app-cta-btn {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-dark) !important;
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .app-cta-btn:hover {
    background: var(--color-gold-light);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .app-cta-inner {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }
    .app-cta-icon {
      font-size: 2rem;
    }
  }
</style>
